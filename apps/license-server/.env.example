# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/video_uniqueizer?schema=public"

# JWT Secret - CHANGE IN PRODUCTION! (min 32 characters)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# Offline Token Settings
# Secret for signing offline tokens (min 64 characters)
OFFLINE_TOKEN_SECRET="your-offline-token-secret-key-must-be-at-least-64-characters-long-for-security"
# Number of days offline tokens are valid
OFFLINE_TOKEN_DAYS=7

# Admin IP Whitelist (comma-separated IPs)
# Only these IPs can access admin endpoints
ADMIN_IP_WHITELIST="127.0.0.1,::1"

# Server Configuration
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# CORS Configuration
# Set to your admin panel URL in production
CORS_ORIGIN=*
