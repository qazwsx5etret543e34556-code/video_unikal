# Desktop Environment Variables (Development)
# Copy to .env and fill in actual values

# License Server URL
LICENSE_SERVER_URL=http://localhost:3001

# Offline Token Secret (must match server)
OFFLINE_TOKEN_SECRET=your_dev_secret_key_change_in_production_minimum_64_characters_long_for_security

# App Version
APP_VERSION=1.0.0

# Enable DevTools in production (false for release)
ENABLE_DEVTOOLS=false

# Log Level (error, warn, info, debug)
LOG_LEVEL=debug
